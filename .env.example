# Hech qachon haqiqiy tokenlarni ushbu namunaviy faylga yoki GitHub kodiga yozmang.
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
ALLOWED_USER_IDS=123456789

# https://my.telegram.org/apps — katta fayllar uchun lokal Bot API serveriga kerak.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=REPLACE_WITH_TELEGRAM_API_HASH

DEFAULT_VOICE=uz-UZ-SardorNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
ORIGINAL_AUDIO_VOLUME=0.10
TRANSLATE_TO_UZBEK=true
MAX_VIDEO_DURATION_MINUTES=360
MAX_OUTPUT_MB=1900
MAX_SRT_MB=15
LOG_LEVEL=INFO

# Docker Compose ichki tarmog‘i; tashqi portni ochmang.
TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081/bot
TELEGRAM_API_FILE_URL=http://telegram-bot-api:8081/file/bot
WORK_DIR=/work/jobs
INBOX_DIR=/work/inbox
